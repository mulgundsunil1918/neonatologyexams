// Neonatology Fellowship Study Platform — data model
// SQLite (fully offline, single file: prisma/dev.db). No enums used — SQLite support for
// Prisma enums is inconsistent across versions, so status-like fields are plain String
// columns validated in application code (see src/lib/constants.ts for the allowed values).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Content: resources (the book/protocol library) ----------

model Resource {
  id        String   @id @default(cuid())
  title     String
  shortName String   @unique // e.g. "aiims-vol1", used in citations
  edition   String? // null = not yet confirmed
  year      Int?
  category  String // "qbank" | "textbook" | "protocol"
  fileName  String
  pageCount Int?
  createdAt DateTime @default(now())

  sources  QuestionSource[]
  chapters Chapter[]
  pages    ResourcePage[]

  @@index([category])
}

// A navigable unit from the book's own embedded outline (never re-derived from prose) —
// see scripts/ingest_resources.py. Two resources have no embedded outline at all
// (NEOCON Ventilation, AIIMS Vol.2); those get one chapter row spanning the whole book
// rather than a guessed breakdown.
model Chapter {
  id         String @id @default(cuid())
  resourceId String
  title      String
  level      Int
  pageStart  Int
  pageEnd    Int

  resource Resource @relation(fields: [resourceId], references: [id])

  @@index([resourceId, pageStart])
}

// Full page text — the substrate for full-text search (see src/lib/search.ts, which builds
// a SQLite FTS5 index over this table) and for verifying a citation actually says what it's
// cited for, rather than trusting a keyword match blindly.
model ResourcePage {
  id         String @id @default(cuid())
  resourceId String
  pageNumber Int
  text       String

  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([resourceId, pageNumber])
}

// ---------- Content: exam structure ----------

model Sitting {
  id    String  @id // e.g. "2021-07"
  label String // human-readable, e.g. "NNF Fellowship Examination, 22nd July 2021"
  year  Int
  month Int?

  papers Paper[]
}

model Paper {
  id           String  @id @default(cuid())
  sittingId    String
  paperNo      Int
  paperType    String // "MCQ" | "THEORY" | "MIXED"
  pageStart    Int
  pageEnd      Int
  totalMarks   Int?
  durationMins Int?
  formatNote   String?

  sitting     Sitting              @relation(fields: [sittingId], references: [id])
  occurrences QuestionOccurrence[]

  @@unique([sittingId, paperNo])
}

// ---------- Content: master questions & occurrences ----------

model MasterQuestion {
  id                String  @id // e.g. "Q000001"
  paperType         String // "MCQ" | "THEORY"
  stem              String
  repetitionTier    String // "RED" (repeated exactly twice) | "ORANGE" (asked once)
  hasImage          Boolean @default(false)
  hasTable          Boolean @default(false)
  flawNote          String?
  confidenceStatus  String  @default("SOURCE_CONFIRMED")
  // "SOURCE_CONFIRMED" | "SOURCE_SUPPORTED" | "SOURCE_DEPENDENT" |
  // "QUESTION_OPTION_FLAWED" | "OUTDATED_SOURCE" | "NOT_FOUND"

  primarySystemId    String?
  secondarySystemId  String?
  topicId            String?
  subtopicId         String?

  // Free-text clinical-topic tag for Theory questions with no subParts (a "discuss in
  // detail" single-topic essay) — used to compute cross-paper repeat counts the same way
  // subParts.topicTag does for lettered questions. Null for MCQs and for Theory questions
  // that have subParts (their tagging lives on the SubPart rows instead).
  topicTag  String?

  createdAt DateTime @default(now())

  occurrences  QuestionOccurrence[]
  options      Option[]
  subParts     SubPart[]
  answer       Answer?
  explanation  Explanation?
  sources      QuestionSource[]
  bookmarks    Bookmark[]
  notes        Note[]
  attempts     Attempt[]
  primarySystem   System? @relation("PrimarySystem", fields: [primarySystemId], references: [id])
  secondarySystem System? @relation("SecondarySystem", fields: [secondarySystemId], references: [id])
  topic           Topic?  @relation(fields: [topicId], references: [id])
  subtopic        Subtopic? @relation(fields: [subtopicId], references: [id])

  @@index([repetitionTier])
  @@index([paperType])
  @@index([primarySystemId])
}

model QuestionOccurrence {
  id              String  @id @default(cuid())
  masterQuestionId String
  paperId         String
  originalQnum    Int
  pdfPageStart    Int
  pdfPageEnd      Int
  extractionMethod String // "text_parse" | "manual_vision_transcription"

  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])
  paper          Paper          @relation(fields: [paperId], references: [id])

  @@unique([paperId, originalQnum])
  @@index([masterQuestionId])
}

model Option {
  id               String @id @default(cuid())
  masterQuestionId String
  letter           String // "A".."E"
  text             String
  sortOrder        Int

  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])

  @@index([masterQuestionId])
}

// Theory-paper lettered sub-parts (a/b/c…) — distinct from MCQ Options.
model SubPart {
  id               String @id @default(cuid())
  masterQuestionId String
  label            String // "A", "B", "C"...
  text             String
  marks            String? // free text, e.g. "3+3+4" as printed
  sortOrder        Int

  // Free-text clinical-topic tag (e.g. "CDH", "Bilirubin encephalopathy (BIND)") assigned
  // by clinical reading of each sub-part, not text-matching — used to compute how many
  // separate Theory questions across all sittings have touched that topic, for the
  // priority/colour tiering on the Theory list and detail pages. Null until tagged.
  topicTag String?

  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])

  @@index([masterQuestionId])
}

model Answer {
  id               String  @id @default(cuid())
  masterQuestionId String  @unique
  correctLetter    String? // null = not yet sourced
  confidenceStatus String  @default("NOT_FOUND")
  sourcedFrom      String? // "printed_key" | "textbook_citation" | null

  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])
}

model Explanation {
  id               String @id @default(cuid())
  masterQuestionId String @unique
  body             String?
  highYieldPoint   String?

  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])
}

// ---------- Classification ----------

model System {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int

  topics             Topic[]
  primaryQuestions   MasterQuestion[] @relation("PrimarySystem")
  secondaryQuestions MasterQuestion[] @relation("SecondarySystem")
}

model Topic {
  id       String @id @default(cuid())
  systemId String
  name     String

  system    System     @relation(fields: [systemId], references: [id])
  subtopics Subtopic[]
  questions MasterQuestion[]

  @@unique([systemId, name])
}

model Subtopic {
  id      String @id @default(cuid())
  topicId String
  name    String

  topic     Topic  @relation(fields: [topicId], references: [id])
  questions MasterQuestion[]

  @@unique([topicId, name])
}

// ---------- Source citations (book/chapter grounding) ----------

model QuestionSource {
  id               String  @id @default(cuid())
  masterQuestionId String
  resourceId       String
  role             String // "primary" | "additional"
  chapter          String? // denormalized chapter title, kept even if chapterId is null
  pageRef          String?
  tableOrFigure    String?
  matchedSnippet   String? // the actual passage text the citation is based on — shown in the UI
                            // so a reader can judge the match themselves rather than trust a label
  confidenceStatus String  @default("NOT_FOUND")
  // "SOURCE_CONFIRMED" (a person/LLM read the passage and confirmed it) |
  // "SOURCE_DEPENDENT" (a search match found this page; passage not yet read/verified) |
  // "NOT_FOUND"
  matchMethod      String? // "keyword_search" | "human_verified"

  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])
  resource       Resource       @relation(fields: [resourceId], references: [id])

  @@index([masterQuestionId])
}

// ---------- User-facing state (schema-ready; auth to be added later) ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  attempts     Attempt[]
  bookmarks    Bookmark[]
  nrpBookmarks NrpBookmark[]
  dmBookmarks  DmBookmark[]
  notes        Note[]
  sessions     StudySession[]
}

model Attempt {
  id               String   @id @default(cuid())
  userId           String
  masterQuestionId String
  selectedLetter   String?
  isCorrect        Boolean?
  timeSpentSecs    Int?
  attemptedAt      DateTime @default(now())
  studySessionId   String?

  // spaced-repetition fields (Part 19) — tracked from the first attempt, not yet scheduled
  confidence     Int? // 1-5 self-rated
  nextReviewDate DateTime?

  user           User            @relation(fields: [userId], references: [id])
  masterQuestion MasterQuestion  @relation(fields: [masterQuestionId], references: [id])
  studySession   StudySession?   @relation(fields: [studySessionId], references: [id])

  @@index([userId, masterQuestionId])
}

model Bookmark {
  id               String   @id @default(cuid())
  userId           String
  masterQuestionId String
  flag             String? // "revise" | "important" | null
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id])
  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])

  @@unique([userId, masterQuestionId])
}

model Note {
  id               String   @id @default(cuid())
  userId           String
  masterQuestionId String
  body             String
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  masterQuestion MasterQuestion @relation(fields: [masterQuestionId], references: [id])
}

// ---------- NRP 9th Edition module ----------
// Deliberately separate from MasterQuestion/QuestionOccurrence above — this content is NOT
// extracted from any exam paper (there is no NRP source document in the uploaded resources).
// It is externally-authored study material (AAP/NRP 9th edition official materials, released
// Oct 2025), so every row here is confidenceStatus "EXTERNAL_VERIFICATION" by construction —
// never to be presented as if it came from the uploaded books.

model NrpChange {
  id           String  @id @default(cuid())
  topic        String // e.g. "Cord management", "Initial steps", "Airway", "Ventilation"
  eighthEd     String // what 8th edition said/did
  ninthEd      String // what changed in 9th edition
  whyItMatters String?
  highYield    Boolean @default(true)
  sortOrder    Int
}

model NrpQuestion {
  id        String @id @default(cuid())
  stem      String
  topic     String
  sortOrder Int

  options     NrpOption[]
  answer      NrpAnswer?
  explanation NrpExplanation?
  bookmarks   NrpBookmark[]
}

model NrpOption {
  id         String @id @default(cuid())
  questionId String
  letter     String
  text       String
  sortOrder  Int

  question NrpQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model NrpAnswer {
  id            String @id @default(cuid())
  questionId    String @unique
  correctLetter String

  question NrpQuestion @relation(fields: [questionId], references: [id])
}

model NrpExplanation {
  id         String @id @default(cuid())
  questionId String @unique
  body       String

  question NrpQuestion @relation(fields: [questionId], references: [id])
}

// A separate table from Bookmark, not a nullable-FK addition to it — same reasoning as the
// rest of this NRP section: this content has no exam-paper/system provenance, so it shouldn't
// share a table (or a masterQuestionId-shaped foreign key) with content that does.
model NrpBookmark {
  id            String   @id @default(cuid())
  userId        String
  nrpQuestionId String
  flag          String? // "revise" | "important" | null — mirrors Bookmark.flag
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  nrpQuestion NrpQuestion @relation(fields: [nrpQuestionId], references: [id])

  @@unique([userId, nrpQuestionId])
}

// ---------- DM/DrNB module ----------
// A second qualification, deliberately kept in its own table family rather than folded into
// MasterQuestion/Sitting/Paper — those are tuned specifically for the NNF/IAP Fellowship bank
// (dashboard totals, tier system, buildMcqWhere filtering) and threading a qualification
// discriminator through every one of those call sites would risk silently corrupting that
// already-live, already-correct experience. Same reasoning as the NRP module above, but this
// content DOES have real exam-paper provenance (unlike NRP) — so unlike NRP it keeps a proper
// Sitting → Paper → QuestionItem hierarchy, verbatim-extracted from the source QBank PDFs (The
// Tamil Nadu Dr. M.G.R. Medical University, D.M. — Neonatology). See scripts/dm_extract.py and
// data/dm_drnb/extracted.json for the extraction (82 paper-instances, 984 items, zero loss —
// every page hand-verified to have exactly 2 "Elaborate on" @15 marks + 10 "Write notes on" @7
// marks before the parser was trusted).

model DmSitting {
  id          String  @id // e.g. "2012-08"
  label       String // e.g. "August 2012"
  sessionNote String? // e.g. "(August 2020 session)" when the printed date and actual session diverge
  sortOrder   Int // chronological display order

  papers DmPaper[]
}

model DmPaper {
  id         String @id @default(cuid())
  sittingId  String
  paperNo    Int // 1-4
  title      String // e.g. "Applied Basic Sciences as Applied to Neonatology and Perinatology; Research Methods"
  subCode    String // e.g. "1451" — stable per paper number across every sitting, a cross-check
  qpCode     String // e.g. "161451" — ditto
  examCode   String? // the university's own per-instance code, e.g. "[LB 081]" / "(DM 0821)" — kept for provenance
  sourceFile String // which of the 4 source PDFs this page came from
  sourcePage Int // 1-indexed page number within that PDF

  sitting DmSitting        @relation(fields: [sittingId], references: [id])
  items   DmQuestionItem[]

  @@unique([sittingId, paperNo])
}

model DmQuestionItem {
  id       String  @id @default(cuid())
  paperId  String
  section  String // "I" (Elaborate on, 15 marks) | "II" (Write notes on, 7 marks)
  itemNo   Int // 1-2 for section I, 1-10 for section II
  label    String // "I.1", "II.7" etc — the original paper's own numbering, kept for traceability
  text     String // verbatim question text
  marks    Int // 15 or 7
  topicTag String? // hand-tagged clinical topic for priority tiering — deliberately coarser/broader
  // than the NNF Theory tags, per Sunil's instruction that "nearer topic" items should cluster
  // together for priority even without exact wording match.

  paper     DmPaper      @relation(fields: [paperId], references: [id])
  answer    DmAnswer?
  bookmarks DmBookmark[]

  @@index([paperId])
}

model DmAnswer {
  id     String @id @default(cuid())
  itemId String @unique
  body   String // markdown model answer, same house style as NNF Theory

  item DmQuestionItem @relation(fields: [itemId], references: [id])
}

// Separate from Bookmark/NrpBookmark for the same reason as NrpBookmark above.
model DmBookmark {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  flag      String?
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id])
  item DmQuestionItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model StudySession {
  id        String    @id @default(cuid())
  userId    String
  mode      String // "paperwise" | "systemwise" | "mcq_master" | ...
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id])
  attempts Attempt[]
}
