# Source PDFs — large, copyrighted reference material. Never goes to git/GitHub.
# Provenance (filename + md5) is tracked in scripts/paper_registry.py instead.
*.pdf

.venv/
__pycache__/
.claude/scheduled_tasks.lock
*.pyc
.DS_Store

# Next.js app
app/node_modules/
app/.next/
app/prisma/dev.db
app/dev.db
app/dev.db-journal
app/prisma/dev.db-journal
app/src/generated/
app/.env

# Extracted full page-text of copyrighted textbooks — same concern as the source PDFs
# (this IS their content, just reformatted). Regenerate any time with:
#   .venv/bin/python scripts/ingest_resources.py
# Chapter/TOC metadata (titles + page numbers only, not the prose) is fine to keep in git.
data/resources/*_pages.json

# Scratch output for in-progress content batches (MCQ/Theory rewrite JSON) — intermediate
# working files applied to dev.db then discarded, not part of the app itself. Kept outside
# /private/tmp (which was found mid-project to get cleared, e.g. on reboot, losing completed
# but not-yet-applied agent work) so it survives until explicitly cleaned up.
/recovered/
